# Manual requests against the mock Wallet (VS Code REST Client extension).
# Start the Wallet first: see README.md in this folder.
# The API key is the public one from the assessment, valid only for the mock.
#
# The Wallet fails randomly: a single 500 here does not mean the request is wrong.
# Re-read the balance to see whether an operation was actually applied.

@baseUrl = http://localhost:8000
@apiKey = Wj9QhLqMUPAHSNMxeT2o

# Seeded wallet users
@userUsd = 34633089486
@userEur = 34679664254
@userKes = 34616761765
@userUsd2 = 34673635133

###############################################################################
# Q2 — Happy path
###############################################################################

### Health (no API key)
GET {{baseUrl}}/health

### Balance — USD player
GET {{baseUrl}}/api/v1/balance/{{userUsd}}
x-api-key: {{apiKey}}

### Balance — EUR player (big balance)
GET {{baseUrl}}/api/v1/balance/{{userEur}}
x-api-key: {{apiKey}}

### Balance — KES player (fractional balance)
GET {{baseUrl}}/api/v1/balance/{{userKes}}
x-api-key: {{apiKey}}

### Balance — second USD player
GET {{baseUrl}}/api/v1/balance/{{userUsd2}}
x-api-key: {{apiKey}}

### Withdraw 10.50 — fresh reference and betId each time
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd}},
  "currency": "USD",
  "transactions": [
    { "amount": 10.50, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Deposit 25.25 — fresh reference and betId each time
POST {{baseUrl}}/api/v1/deposit
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd}},
  "currency": "USD",
  "transactions": [
    { "amount": 25.25, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Withdraw 0.01 from the big EUR balance (precision check)
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userEur}},
  "currency": "EUR",
  "transactions": [
    { "amount": 0.01, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

###############################################################################
# Q3 — x-api-key
###############################################################################

### No API key → 401
GET {{baseUrl}}/api/v1/balance/{{userUsd2}}

### Wrong API key → 401
GET {{baseUrl}}/api/v1/balance/{{userUsd2}}
x-api-key: wrong

### Right key value in lowercase → 401 (value is case-sensitive)
GET {{baseUrl}}/api/v1/balance/{{userUsd2}}
x-api-key: wj9qhlqmupahsnmxet2o

### Header name in uppercase → 200 (header names are case-insensitive)
GET {{baseUrl}}/api/v1/balance/{{userUsd2}}
X-API-KEY: {{apiKey}}

### Withdraw with wrong key → 401, balance must not change
POST {{baseUrl}}/api/v1/withdraw
x-api-key: wrong
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": 1.00, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

###############################################################################
# Q4 — Validation (the Wallet validates very little: see findings)
###############################################################################

### Negative amount → 400 InvalidRequest
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": -5, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### 3 decimals → 200, APPLIED with 3 decimals
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": 0.001, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Amount as string → 200, applied
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": "1.00", "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Zero amount → 200, nothing moves
POST {{baseUrl}}/api/v1/deposit
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": 0, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Unknown user → 400 UserNotFound
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": 12345,
  "currency": "USD",
  "transactions": [
    { "amount": 1, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Currency mismatch → 400 InvalidCurrency
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "EUR",
  "transactions": [
    { "amount": 1, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Empty transactions → 400 InvalidRequest
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": []
}

### Two transactions, the second invalid → 400, NOTHING applied
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [
    { "amount": 1, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" },
    { "amount": -1, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Balance of unknown user → 200 with "0" and empty currency (!)
GET {{baseUrl}}/api/v1/balance/12345
x-api-key: {{apiKey}}

###############################################################################
# Q5 — Insufficient funds (KES player starts at 750.5 after a restart)
###############################################################################

### Above balance → 400 InsufficientBalance
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userKes}},
  "currency": "KES",
  "transactions": [
    { "amount": 750.51, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

### Exact balance → ALSO 400 InsufficientBalance (Wallet requires amount < balance)
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userKes}},
  "currency": "KES",
  "transactions": [
    { "amount": 750.5, "betId": {{$randomInt 1 1000000000}}, "reference": "{{$guid}}" }
  ]
}

###############################################################################
# Q8 — Duplicates. Fixed betId/reference on purpose: run the requests in order.
# To replay the section, restart the Wallet or change the two values below.
###############################################################################

@dupBet = 900001
@dupRef = dup-demo-1

### 1. Withdraw dupBet/dupRef → 200 (or 500 / dropped: still applied or not, check balance)
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 1, "betId": {{dupBet}}, "reference": "{{dupRef}}" } ]
}

### 2. Identical re-send → 409 DuplicatedTransaction (means: already applied)
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 1, "betId": {{dupBet}}, "reference": "{{dupRef}}" } ]
}

### 3. Same key, different amount → still 409 (amount is not part of the key)
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 2, "betId": {{dupBet}}, "reference": "{{dupRef}}" } ]
}

### 4. Deposit with the same betId/reference → 200 (separate namespace)
POST {{baseUrl}}/api/v1/deposit
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 1, "betId": {{dupBet}}, "reference": "{{dupRef}}" } ]
}

### 5. Deposit with another betId but the same reference → 409 (deposit key = reference)
POST {{baseUrl}}/api/v1/deposit
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 1, "betId": 900002, "reference": "{{dupRef}}" } ]
}

###############################################################################
# Q9 — Reverting = compensating operation (same amount, same betId, new reference)
###############################################################################

@revBet = 900101

### 1. Withdraw 10 on bet revBet
POST {{baseUrl}}/api/v1/withdraw
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 10, "betId": {{revBet}}, "reference": "{{$guid}}" } ]
}

### 2. Revert it with a deposit of 10, same bet, new reference → balance restored
POST {{baseUrl}}/api/v1/deposit
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "userId": {{userUsd2}},
  "currency": "USD",
  "transactions": [ { "amount": 10, "betId": {{revBet}}, "reference": "{{$guid}}" } ]
}
