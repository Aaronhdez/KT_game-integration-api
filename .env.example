# Copy to .env and adjust. Never commit .env.

HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# PostgreSQL (the compose `postgres` service).
# Use only letters, digits, '-' and '_' in the password: docker compose puts it
# inside DATABASE_URL without URL-encoding it.
POSTGRES_USER=gameapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gameapi
# Under docker compose, DATABASE_URL and WALLET_BASE_URL are built in
# docker-compose.yml (from POSTGRES_* and the service names) and these lines are
# ignored. They are the values for `go run ./Startup` against the compose services.
DATABASE_URL=postgres://gameapi:change-me@localhost:5432/gameapi?sslmode=disable
# Only for `go test -tags=integration` (database created by the compose
# `postgres` service on first start; never the service's own database):
# TEST_DATABASE_URL=postgres://gameapi:change-me@localhost:5432/gameapi_test?sslmode=disable

# Wallet mock (kentechsp/wallet-client).
# The API key is the one published in the assessment, valid only for the mock.
WALLET_BASE_URL=http://localhost:8000
WALLET_API_KEY=Wj9QhLqMUPAHSNMxeT2o
# Withdraw/deposit are never answered after ~5 s; balance reads can take ~15 s
# (docs/wallet-findings.md, Q7). Balance reads are retried once.
WALLET_OPERATION_TIMEOUT=6s
WALLET_BALANCE_TIMEOUT=10s

# JWT (HS256). The secret is required and must be at least 32 bytes long;
# generate one with e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1h

# Pending resolver: how often PENDING transactions are re-sent to the Wallet.
# Each one waits at least 10 s after its last attempt (findings Q8).
PENDING_RESOLVER_INTERVAL=10s
